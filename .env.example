# =====================================================================
# Plantilla de variables de entorno. Copiar a .env.local y rellenar.
# NUNCA versionar el archivo con valores reales.
#
# Regla de oro: todo lo que empiece por EXPO_PUBLIC_ o NEXT_PUBLIC_
# viaja al cliente y es PUBLICO. Lo demas vive solo en el servidor.
# =====================================================================

# ---------- SUPABASE ----------
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO servidor. Si esto aparece en el bundle de la app, es un incidente.
SUPABASE_SERVICE_ROLE_KEY=
# La usa `pnpm db:push` (via scripts/db-push.sh). El valor de abajo es el de
# un Supabase local; contra juicebar-dev va la cadena del Session pooler,
# puerto 5432 — Dashboard -> Connect. Ver docs/PASO-A-PASO.md, seccion 3.4.
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Opcional. `pnpm db:types` saca el ref del proyecto de las URL de arriba;
# esto solo hace falta para apuntar a otro proyecto sin tocarlas.
# SUPABASE_PROJECT_ID=

# ---------- CLOVER (solo backend, jamas en la app) ----------
CLOVER_APP_ID=
CLOVER_APP_SECRET=
CLOVER_WEBHOOK_AUTH_CODE=            # se valida en el header X-Clover-Auth
CLOVER_HOSTED_CHECKOUT_SECRET=       # firma Clover-Signature (distinta)

# LOS HOSTS DE CLOVER YA NO SE CONFIGURAN AQUI, y no es una simplificacion:
# son CUATRO por entorno, no dos. Plataforma, OAuth (solo `authorize`),
# ecommerce y tokenizacion viven en dominios distintos, y mandar la
# peticion correcta al host equivocado no da un 404 — da un 401, o un HTML
# de portal. Los ocho estan verificados en packages/clover-client
# (environments.ts) y se eligen por el `environment` de CADA CONEXION, que
# vive en la fila: la misma Edge Function atiende sucursales en sandbox y
# en produccion, que durante un alta conviven.
#
# Las dos variables que habia aqui —CLOVER_API_BASE_URL y
# CLOVER_OAUTH_BASE_URL— cubrian dos de los cuatro y no las leia nadie.
# Ver docs/CLOVER-ENDPOINTS.md.

# El callback de OAuth es una Edge Function de Supabase, no una ruta del
# SaaS. Se calcula solo a partir de SUPABASE_URL; esta variable es
# OPCIONAL y solo sirve de red: si se pone, el arranque comprueba que sea
# identica a la que la funcion atiende y revienta si no.
#
# TIENE QUE ESTAR REGISTRADA IGUAL, CARACTER A CARACTER, en el Developer
# Dashboard de Clover. Sin barra final. Ver docs/OAUTH-CONEXION.md.
# CLOVER_REDIRECT_URL=https://xxxx.supabase.co/functions/v1/oauth/callback

# ---------- WORKER DE REFRESCO DE TOKENS ----------
# El secreto con el que pg_cron se identifica ante la Edge Function
# `token-refresh`. Es lo UNICO que la protege: se despliega sin
# verificacion de JWT porque la comprobacion del gateway la pasa cualquier
# clave del proyecto, y la anonima viaja dentro del APK.
#
# Generarlo con:  openssl rand -base64 32
#
# VA EN LOS DOS EXTREMOS DEL MISMO CABLE, y tiene que ser identico:
#   supabase secrets set WORKER_CRON_SECRET=...
#   select app.configure_token_refresh_worker('https://xxxx.supabase.co', '...');
# Si no coinciden, la funcion contesta 401 y nadie rota ningun token. Se
# ve con: select * from app.token_refresh_worker_status();
WORKER_CRON_SECRET=

# ---------- NOTIFICACIONES ----------
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
EXPO_PUBLIC_FCM_SENDER_ID=

# ---------- OBSERVABILIDAD ----------
SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ---------- APP ----------
EXPO_PUBLIC_RESTAURANT_ID=           # una marca por build (ver §19)
EXPO_PUBLIC_APP_ENV=development

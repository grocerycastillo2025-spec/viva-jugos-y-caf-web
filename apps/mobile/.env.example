# Variables de la app movil.
#
# Se pueden poner aqui (apps/mobile/.env.local) o en el .env.local de la
# raiz del repositorio: `scripts/with-env.mjs` lee los dos y lo de aqui
# gana. Nada de esto es secreto: todo lo que empieza por EXPO_PUBLIC_
# viaja dentro del bundle y cualquiera puede leerlo.

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave PUBLICABLE (sb_publishable_...) o la anon legacy (eyJ...).
# NUNCA la secret / service_role: la app la rechaza al arrancar.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# La MARCA que sirve esta build (§19: una app por marca). Por defecto,
# Viva Juice and Coffee.
#
# Las SUCURSALES no se fijan aqui: salen de la tabla `stores` y las elige
# el cliente en la app, porque cada una es un merchant distinto de Clover
# con su propio catalogo y sus propios precios.
EXPO_PUBLIC_RESTAURANT_ID=11111111-1111-4111-8111-111111111111

EXPO_PUBLIC_APP_ENV=development

# Google OAuth. Solo se enciende cuando el proveedor esta configurado en
# el dashboard de Supabase (Authentication -> Providers -> Google) con la
# URL de redireccion de la app. Sin esto, el boton no aparece: mas vale no
# ensenarlo que ensenar uno que falla.
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false

{
  "expo": {
    "name": "VIVA Jugos y Café",
    "slug": "juicebar-mobile",
    "scheme": "vivajuice",
    "version": "0.1.0",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0E4A2B",
    "primaryColor": "#0E4A2B",
    "orientation": "default",
    "icon": "../../assets/brand/icon.png",
    "updates": {
      "url": "https://u.expo.dev/4ed95bba-1725-4c3a-abf9-910f0fd1a351",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "1.0.0",
    "ios": {
      "bundleIdentifier": "com.vivajuicecoffee.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.vivajuicecoffee.app",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "../../assets/brand/adaptive-icon.png",
        "backgroundColor": "#0E4A2B"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "VIVA Jugos y Café",
      "shortName": "VIVA",
      "lang": "es",
      "description": "Pide jugos naturales, licuados, bowls y café en VIVA Jugos y Café.",
      "themeColor": "#0E4A2B",
      "backgroundColor": "#F5F0E6",
      "favicon": "./public/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "../../assets/brand/splash.png",
          "backgroundColor": "#0E4A2B",
          "resizeMode": "contain",
          "imageWidth": 220
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "../../assets/brand/notification-icon.png",
          "color": "#0E4A2B",
          "defaultChannel": "orders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "restaurantId": "11111111-1111-4111-8111-111111111111",
      "eas": {
        "projectId": "4ed95bba-1725-4c3a-abf9-910f0fd1a351"
      },
      "currency": "MXN",
      "locale": "es-MX"
    }
  }
}
